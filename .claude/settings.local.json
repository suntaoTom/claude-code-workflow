      "Bash(rg:*)",
      "Bash(find:*)",
      "Bash(wc:*)",
      "Bash(sed:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(diff:*)",
      "Bash(tree:*)",
      "Bash(node:*)",
      "Bash(npx:*)",
      "Bash(echo:*)",
      "Bash(which:*)",
      "Bash(pwd)",
