{
  "version": 1,
  "workflows": {
    "main": {
      "name": "Java 后端主开发流程",
      "description": "从后端能力需求到可验证的服务发布",
      "color": "#1677ff",
      "steps": [
        {"command": "prd", "type": "action", "label": "写后端需求书", "next": ["prd-check"]},
        {"command": "prd-check", "type": "gate", "label": "需求契约检查", "next": ["plan"]},
        {"command": "plan", "type": "action", "label": "拆解 Java 任务", "next": ["plan-check"]},
        {"command": "plan-check", "type": "gate", "label": "任务依赖检查", "next": ["code"]},
        {"command": "code", "type": "action", "label": "实现 Java 服务", "next": ["test"]},
        {"command": "test", "type": "action", "label": "生成并运行测试", "next": ["review"]},
        {"command": "review", "type": "gate", "label": "后端代码审查", "next": ["security-gate"]},
        {"command": "security-gate", "type": "gate", "label": "安全与泄密门禁", "next": ["build"]},
        {"command": "build", "type": "action", "label": "Maven/Docker 构建", "next": ["deploy"]},
        {"command": "deploy", "type": "action", "label": "部署并健康检查", "next": ["release"]},
        {"command": "release", "type": "action", "label": "版本与变更发布", "next": []}
      ]
    },
    "bugfix": {
      "name": "后端 Bug 修复流程",
      "description": "从故障分诊到可回归验证的修复",
      "color": "#f5222d",
      "steps": [
        {"command": "bug-check", "type": "gate", "label": "故障分诊", "next": ["fix"]},
        {"command": "fix", "type": "action", "label": "最小修复", "next": ["test"], "merge-into": "main"}
      ]
    },
    "utility": {
      "name": "独立工具",
      "description": "可单独执行的入职和一致性工具",
      "color": "#722ed1",
      "steps": [
        {"command": "start", "type": "action", "label": "项目入职", "next": []},
        {"command": "meta-audit", "type": "action", "label": "元审计", "next": []}
      ]
    }
  }
}
